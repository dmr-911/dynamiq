{
  "name": "dynamiq",
  "version": "0.1.0",
  "description": "A versatile dynamic form component for React/Next.js with grid layouts, validation, and field types",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "formik": "^2.2.0",
    "yup": "^1.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "class-variance-authority": "^0.7.0",
    "lodash": "^4.17.21",
    "dayjs": "^1.11.10",
    "date-fns": "^3.0.0",
    "@floating-ui/react": "^0.26.0",
    "@headlessui/react": "^2.0.0",
    "react-dropzone": "^14.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/lodash": "^4.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "nextjs",
    "form",
    "dynamic-form",
    "formik",
    "yup",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/dynamic-form"
  },
  "bugs": {
    "url": "https://github.com/your-username/dynamic-form/issues"
  }
}